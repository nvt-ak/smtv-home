<?xml version="1.0" encoding="utf-8"?>
<!-- Glass tile (design_profile aurora): translucent dark fill, hairline border, cyan ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#CC172B35" />
            <stroke android:width="2dp" android:color="#FF74E5F4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#99142029" />
            <stroke android:width="1dp" android:color="#337FCFE0" />
        </shape>
    </item>
</selector>
